# --- Postgres ---
POSTGRES_USER=automao
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=automao
POSTGRES_PORT=5432

# --- Browserless (scraping headless Chrome) ---
BROWSERLESS_TOKEN=change-me-random-token
BROWSERLESS_PORT=3001

# --- Connectors API (Express) ---
CONNECTORS_PORT=3000
CONNECTORS_API_KEY=change-me-shared-secret-with-n8n

# --- LLM (matching + cover letter) ---
# Escolha um:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic                 # anthropic | openai
LLM_MODEL=claude-sonnet-4-6
MATCH_SCORE_THRESHOLD=70

# --- Plataformas: credenciais (deixe em branco o que não usar) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_LI_AT=                        # cookie de sessão (alternativa a email/senha)

GUPY_TOKEN=                            # opcional, melhora rate limit

INDEED_PUBLISHER_ID=                   # se usar API parceiro

# --- Notificações ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Snapshot diário pro Git ---
GIT_REMOTE=git@github.com:fabiokansas-maker/automa-o.git
GIT_BRANCH_SNAPSHOT=claude/download-local-files-5hfmT
GIT_AUTHOR_NAME=automa-o-bot
GIT_AUTHOR_EMAIL=bot@automa-o.local

# --- n8n existente (referência, n8n não roda neste compose) ---
N8N_URL=https://seu-n8n.exemplo.com
N8N_API_KEY=
